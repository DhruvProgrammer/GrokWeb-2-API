# --- Authentication ---
# Open https://grok.com, sign in, then in DevTools (F12) go to
# Application > Cookies > https://grok.com and copy:
#   - the Value of "sso"         -> GROK_SSO_COOKIE
#   - the Value of "sso-rw"      -> GROK_SSO_RW_COOKIE
#   - the Value of "cf_clearance" -> GROK_CF_CLEARANCE   (required!)
#   - the Value of "__cf_bm"     -> GROK_CF_BM
#
# cf_clearance is what Cloudflare sets after you solve the JS challenge
# in a real browser. It expires (~30 min) so refresh by reloading
# grok.com if requests start returning 403.
GROK_SSO_COOKIE=
GROK_SSO_RW_COOKIE=
GROK_CF_CLEARANCE=
GROK_CF_BM=

# --- Anti-bot challenge ---
# Run scripts/extract-challenge.js in your browser console on grok.com
# to get these values. The header is 49 bytes hex; the trailer is
# a single byte (typically 3).
CHALLENGE_HEADER_HEX=
CHALLENGE_TRAILER=3

# --- Server ---
PORT=4982
HOST=0.0.0.0
LOG_LEVEL=INFO
GROK_TEMPORARY=true

# --- Rate limiting (per client IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# --- Optional overrides (defaults usually fine) ---
# GROK_BASE_URL=https://grok.com
# GROK_ORIGIN=https://grok.com
# GROK_USER_AGENT=Mozilla/5.0 ...